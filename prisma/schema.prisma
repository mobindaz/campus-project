// Prisma schema for Campus Operations Platform
// Single-tenant PostgreSQL database per college deployment

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String                @id @default(cuid())
  name             String
  email            String                @unique
  emailVerified    Boolean               @default(false)
  image            String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  sessions         Session[]
  accounts         Account[]
  userRoles        UserRole[]
  departmentScopes UserDepartmentScope[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

model Role {
  id              String           @id @default(cuid())
  name            String           @unique
  code            String           @unique
  description     String?
  isSystem        Boolean          @default(false)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(cuid())
  code            String           @unique
  name            String
  module          String
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@map("user_roles")
}

enum DepartmentType {
  ACADEMIC
  ADMINISTRATIVE
}

enum ProgramType {
  DEGREE
  DIPLOMA
  POST_GRADUATE
  CERTIFICATE
  DOCTORAL
}

model Program {
  id              String           @id @default(cuid())
  name            String           @unique
  code            String           @unique
  shortName       String
  type            ProgramType      @default(DEGREE)
  durationYears   Int              @default(4)
  isActive        Boolean          @default(true)
  customFields    Json             @default("{}")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  departments     Department[]
  academicPeriods AcademicPeriod[]
  batches         Batch[]
  students        Student[]

  @@map("programs")
}

model Department {
  id              String                @id @default(cuid())
  name            String                @unique
  code            String                @unique
  type            DepartmentType        @default(ACADEMIC)
  description     String?
  programId       String?
  program         Program?              @relation(fields: [programId], references: [id], onDelete: SetNull)
  isActive        Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  userScopes      UserDepartmentScope[]
  academicPeriods AcademicPeriod[]
  batches         Batch[]
  students        Student[]

  @@index([programId])
  @@map("departments")
}

enum AcademicPeriodPattern {
  SEMESTER
  YEAR
  TERM
  TRIMESTER
  CUSTOM
}

model AcademicPeriod {
  id           String                @id @default(cuid())
  name         String
  code         String
  pattern      AcademicPeriodPattern @default(SEMESTER)
  orderIndex   Int                   @default(1)
  programId    String
  program      Program               @relation(fields: [programId], references: [id], onDelete: Cascade)
  departmentId String?
  department   Department?           @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  isActive     Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  students     Student[]

  @@unique([programId, code])
  @@index([programId, orderIndex])
  @@index([departmentId])
  @@map("academic_periods")
}

model Batch {
  id             String    @id @default(cuid())
  name           String
  code           String
  academicYear   String
  admissionYear  Int
  graduationYear Int
  section        String?
  programId      String
  program        Program   @relation(fields: [programId], references: [id], onDelete: Cascade)
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  students       Student[]

  @@unique([programId, code])
  @@index([programId])
  @@index([departmentId])
  @@map("batches")
}

model CollegeProfile {
  id             String   @id @default(cuid())
  name           String   @default("Campus Operations College")
  logoUrl        String?
  address        String?
  city           String?
  state          String?
  postalCode     String?
  country        String?  @default("India")
  contactEmail   String?
  contactPhone   String?
  website        String?
  primaryColor   String   @default("#4F46E5")
  secondaryColor String   @default("#06B6D4")
  isConfigured   Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("college_profiles")
}

model UserDepartmentScope {
  id           String     @id @default(cuid())
  userId       String
  departmentId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([userId, departmentId])
  @@map("user_department_scopes")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String?
  action    String
  entity    String
  entityId  String
  details   Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@map("audit_logs")
}

enum CustomFieldType {
  TEXT
  TEXTAREA
  NUMBER
  DECIMAL
  EMAIL
  PHONE
  DATE
  DATETIME
  DROPDOWN
  MULTI_SELECT
  RADIO
  CHECKBOX
  FILE
  IMAGE
  URL
  CURRENCY
}

model CustomFieldDefinition {
  id           String          @id @default(cuid())
  entityType   String          // e.g. "STUDENT", "FACULTY", "COMPANY", "PLACEMENT_DRIVE"
  name         String          // camelCase field key e.g. "parentPhone"
  label        String          // Display label e.g. "Parent Phone"
  type         CustomFieldType
  required     Boolean         @default(false)
  unique       Boolean         @default(false)
  defaultValue Json?
  validation   Json?           // { min?, max?, minLength?, maxLength?, pattern? }
  visibility   String          @default("ALL") // "ALL", "ADMIN_ONLY", "READ_ONLY"
  order        Int             @default(0)
  helpText     String?
  options      Json?           // ["Option 1", "Option 2"] or [{label, value}]
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  formFields   FormField[]

  @@unique([entityType, name])
  @@index([entityType, isActive])
  @@map("custom_field_definitions")
}

model Student {
  id               String         @id @default(cuid())
  registerNumber   String         @unique
  name             String
  email            String?        @unique
  phone            String?
  dateOfBirth      DateTime?
  programId        String
  program          Program        @relation(fields: [programId], references: [id], onDelete: Restrict)
  departmentId     String?
  department       Department?    @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  batchId          String
  batch            Batch          @relation(fields: [batchId], references: [id], onDelete: Restrict)
  academicPeriodId String
  academicPeriod   AcademicPeriod @relation(fields: [academicPeriodId], references: [id], onDelete: Restrict)
  isActive         Boolean        @default(true)
  customFields     Json           @default("{}")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([customFields], type: Gin)
  @@index([programId, departmentId, batchId])
  @@map("students")
}

model FormDefinition {
  id          String      @id @default(cuid())
  code        String      @unique
  name        String
  entityType  String
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  fields      FormField[]

  @@map("form_definitions")
}

model FormField {
  id               String                 @id @default(cuid())
  formDefinitionId String
  formDefinition   FormDefinition         @relation(fields: [formDefinitionId], references: [id], onDelete: Cascade)
  fieldKey         String
  label            String
  type             String
  isCore           Boolean                @default(false)
  customFieldId    String?
  customField      CustomFieldDefinition? @relation(fields: [customFieldId], references: [id], onDelete: SetNull)
  required         Boolean                @default(false)
  order            Int                    @default(0)
  placeholder      String?
  helpText         String?
  options          Json?
  validation       Json?
  defaultValue     Json?
  isActive         Boolean                @default(true)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@unique([formDefinitionId, fieldKey], name: "formDefinitionId_fieldKey")
  @@index([formDefinitionId, order])
  @@map("form_fields")
}

model ImportMapping {
  id          String   @id @default(cuid())
  name        String
  entityType  String
  mapping     Json
  isDefault   Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([entityType, name])
  @@index([entityType, isDefault])
  @@map("import_mappings")
}

model ValueMapping {
  id          String   @id @default(cuid())
  entityType  String   // e.g. "STUDENT", "FACULTY"
  fieldKey    String   // e.g. "department", "program", "batch", "academicPeriod"
  sourceValue String   // e.g. "CSE", "CS", "Computer Science"
  targetId    String   // target entity ID or canonical option value
  targetLabel String   // human-readable label e.g. "Computer Science & Engineering"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([entityType, fieldKey, sourceValue])
  @@index([entityType, fieldKey])
  @@map("value_mappings")
}

model ImportHistory {
  id           String   @id @default(cuid())
  entityType   String   // e.g. "STUDENT", "FACULTY"
  fileName     String
  fileSize     Int?
  uploadedById String?
  uploadedBy   String   // user email or display name
  matchingKey  String   @default("registerNumber")
  totalRows    Int
  createdCount Int      @default(0)
  updatedCount Int      @default(0)
  skippedCount Int      @default(0)
  errorCount   Int      @default(0)
  status       String   @default("COMPLETED") // "COMPLETED", "PARTIAL", "FAILED"
  errors       Json?    // Array of failed row records
  metadata     Json?    // column mappings, value mappings used
  createdAt    DateTime @default(now())

  @@index([entityType, createdAt])
  @@index([uploadedById])
  @@map("import_history")
}









