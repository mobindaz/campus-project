# ==========================================
# Campus Operations Platform — Environment Variables
# ==========================================

# ------------------------------------------
# Core & Database (Phase 0)
# ------------------------------------------
# PostgreSQL connection string. For local Docker:
# DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/campus_ops?schema=public"
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/campus_ops?schema=public"

# Application Base URL
APP_URL="http://localhost:3000"

# Node environment (development | production | test)
NODE_ENV="development"

# ------------------------------------------
# Authentication (Phase 1)
# ------------------------------------------
# Better Auth secret key used for encrypting session cookies (min 32 characters)
AUTH_SECRET="dev_secret_key_change_me_in_production_min_32_chars"

# ------------------------------------------
# Email & Background Jobs (Phase 8)
# ------------------------------------------
# Resend API key for transaction emails (Phase 8)
RESEND_API_KEY="re_123456789_placeholder"

# Sender Email Address (Phase 8)
EMAIL_FROM="noreply@campusops.dev"

# Inngest Background Worker Keys (Phase 8)
INNGEST_EVENT_KEY="inngest_event_key_placeholder"
INNGEST_SIGNING_KEY="inngest_signing_key_placeholder"

# ------------------------------------------
# Cloudflare R2 Storage (Phase 10)
# ------------------------------------------
# S3-compatible file storage credentials (Phase 10)
R2_ACCOUNT_ID="r2_account_id_placeholder"
R2_ACCESS_KEY_ID="r2_access_key_id_placeholder"
R2_SECRET_ACCESS_KEY="r2_secret_access_key_placeholder"
R2_BUCKET_NAME="campus-ops-files-dev"
R2_PUBLIC_DOMAIN="https://files-dev.campusops.dev"

# ------------------------------------------
# Rate Limiting & Caching (Phase 10)
# ------------------------------------------
# Upstash Redis REST configuration (Phase 10)
UPSTASH_REDIS_REST_URL="https://placeholder.upstash.io"
UPSTASH_REDIS_REST_TOKEN="upstash_rest_token_placeholder"
